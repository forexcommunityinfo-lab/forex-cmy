# ── Frontend environment variables ──
REACT_APP_BACKEND_URL=
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false

# ── PostHog analytics (client-side, initialized only after cookie consent) ──
# Get key from: https://app.posthog.com/project/settings
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=https://app.posthog.com

# Vercel server-side only (never prefix these with REACT_APP_)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Forex CMY <notifiche@send.forexcmy.com>
CONTACT_TO_EMAIL=info@forexcmy.com
